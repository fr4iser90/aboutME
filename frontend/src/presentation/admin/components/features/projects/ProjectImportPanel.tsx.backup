import { ImportForm } from './project-import-panel/components/ImportForm';
import { ResultsHeader } from './project-import-panel/components/ResultsHeader';
import { ProjectGridItem } from './project-import-panel/components/ProjectGridItem';
import { useProjectImport } from './project-import-panel/hooks/useProjectImport';
import { TOKEN_HINT_TEXT } from './project-import-panel/constants';

export function ProjectImportPanel() {
  const {
    formData,
    state,
    updateFormData,
    fetchProjects,
    handleSelect,
    handleSelectAll,
    handleEdit,
    handleEditSave,
    handleEditCancel,
    handleEditDataChange,
    handleImport,
  } = useProjectImport();

  const isManualSource = formData.source === 'manual';

  return (
    <div className="project-import-panel">
      <h2 className="project-import-panel__title">Projekte importieren</h2>
      
      <ImportForm 
        formData={formData}
        loading={state.loading}
        onFormDataChange={updateFormData}
        onFetchProjects={fetchProjects}
      />
      
      {!isManualSource && (
        <div className="project-import-panel__token-hint">
          {TOKEN_HINT_TEXT}
        </div>
      )}
      
      {state.error && (
        <div className="project-import-panel__error">{state.error}</div>
      )}
      
      {state.projects.length > 0 && (
        <>
          <ResultsHeader 
            projectsCount={state.projects.length}
            selectedCount={state.selected.size}
            selectAll={state.selectAll}
            onSelectAll={handleSelectAll}
            onImport={handleImport}
          />
          
          <div className="project-import-panel__grid">
            {state.projects.map((project, idx) => (
              <ProjectGridItem
                key={project.id || idx}
                project={project}
                index={idx}
                isSelected={state.selected.has(idx)}
                isEditing={state.editIndex === idx}
                onSelect={handleSelect}
                onEdit={handleEdit}
                onEditSave={handleEditSave}
                onEditCancel={handleEditCancel}
                editData={state.editData}
                onEditDataChange={handleEditDataChange}
              />
            ))}
          </div>
        </>
      )}
    </div>
  );
}
