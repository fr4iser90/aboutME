# ===========================================
# PORTFOLIO CONFIGURATION (single-admin)
# ===========================================

# GitHub Integration (Required)
GITHUB_USERNAME=

# GitHub API Token (Optional - better rate limits)
# Fine-grained: contents:read, metadata:read
GITHUB_TOKEN=

# Portfolio Basics (Optional - auto-filled when empty)
PORTFOLIO_TITLE=
PORTFOLIO_DESCRIPTION=
PORTFOLIO_AUTHOR=

# Auth — single admin password (required for CMS)
ENABLE_AUTH=true
ADMIN_PASSWORD=

# Optional: durable auth files dir (Docker uses /app/auth-state)
# AUTH_STATE_DIR=

# ===========================================
# FEATURE FLAGS
# ===========================================

ENABLE_CONTACT=
ENABLE_GAME_TERMINAL=

# ===========================================
# TERMINAL (optional public widget)
# ===========================================

TERMINAL_HOSTNAME=
TERMINAL_USERNAME=
TERMINAL_PASSWORD=
TERMINAL_PASSWORD_HINT=
TERMINAL_ROOTPASSWORD=
TERMINAL_ROOTPASSWORD_HINT=
