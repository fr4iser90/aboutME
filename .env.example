# ===========================================
# PORTFOLIO CONFIGURATION
# ===========================================

# GitHub Integration (Required)
GITHUB_USERNAME=

# GitHub API Token (Optional - für bessere Rate Limits) 
# Classic Token: has full repo access (read + write) 
# Fine-grained: contents:read, metadata:read ← RECOMMENDED for read-only 
GITHUB_TOKEN=

# Portfolio Basics (Optional - werden auto-generiert)
PORTFOLIO_TITLE=
PORTFOLIO_DESCRIPTION=
PORTFOLIO_AUTHOR=

# Backend Features ()
ENABLE_AUTH=

ADMIN_PASSWORD=


# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# FEATURE FLAGS
# ===========================================

# Core Features
#ENABLE_BLOG=true
ENABLE_CONTACT=
ENABLE_GAME_TERMINAL=

# ===========================================
# TERMINAL GAME CONFIGURATION
# ===========================================

TERMINAL_HOSTNAME=
TERMINAL_USERNAME=
TERMINAL_PASSWORD=
TERMINAL_PASSWORD_HINT=
TERMINAL_ROOTPASSWORD=
TERMINAL_ROOTPASSWORD_HINT=


