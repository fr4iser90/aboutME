# ===========================================
# PORTFOLIO CONFIGURATION
# ===========================================

# GitHub Integration (Required)
GITHUB_USERNAME=

# GitHub API Token (Optional - für bessere Rate Limits)
GITHUB_TOKEN=

# Portfolio Basics (Optional - werden auto-generiert)
PORTFOLIO_TITLE=
PORTFOLIO_DESCRIPTION=
PORTFOLIO_AUTHOR=

# Backend Features (Optional - true/false)
ENABLE_AUTH=

# Auth Mode Configuration
AUTH_MODE=custom  # Options: 'custom', 'oauth', 'both'

ADMIN_PASSWORD=

# Secrets (Optional - auto generated when empty)
SESSION_SECRET= 
NEXTAUTH_SECRET= 

# OAuth Providers (Only needed if AUTH_MODE=oauth or AUTH_MODE=both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# FEATURE FLAGS
# ===========================================

# Core Features
#ENABLE_BLOG=true
ENABLE_CONTACT=
ENABLE_GAME_TERMINAL=

# ===========================================
# TERMINAL GAME CONFIGURATION
# ===========================================

TERMINAL_HOSTNAME=
TERMINAL_USERNAME=
TERMINAL_PASSWORD=
TERMINAL_PASSWORD_HINT=
TERMINAL_ROOTPASSWORD=
TERMINAL_ROOTPASSWORD_HINT=


